{
  "name": "autotrack-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:clean-orphan-tasks": "node --env-file=.env.local scripts/clean-orphan-tasks.mjs",
    "seed:demo-leads": "node --env-file=.env.local scripts/reset-demo-leads.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:ui": "jest --runInBand tests/ui",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:nfr": "playwright test --config tests/nonfunctional/playwright.config.ts",
    "test:recovery": "node tests/recovery/run.mjs",
    "test:dependencies": "node tests/nonfunctional/dependency-audit.mjs",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:supabase": "node tests/supabase/run.mjs",
    "test:atomic-db": "node tests/atomic/run.mjs",
    "test:atomic-concurrency": "node tests/atomic/concurrency.mjs",
    "test:data-recovery": "node tests/data-recovery/run.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "next": "^16.4.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
